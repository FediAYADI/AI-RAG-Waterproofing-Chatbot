# API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Vector Database
VECTOR_DB_TYPE=chromadb  # Options: chromadb, faiss, pinecone
VECTOR_DB_PATH=./data/vector_store
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENVIRONMENT=your_pinecone_environment

# Application
APP_NAME=AI RAG Waterproofing Chatbot
APP_VERSION=1.0.0
DEBUG=False
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=sqlite:///./data/chatbot.db

# RAG Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K_RETRIEVAL=5
TEMPERATURE=0.7
MAX_TOKENS=2000

# Embedding Model
EMBEDDING_MODEL=text-embedding-ada-002
# EMBEDDING_MODEL=huggingface/sentence-transformers/all-MiniLM-L6-v2

# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic, local
LLM_MODEL=gpt-4
# LLM_MODEL=claude-3-opus-20240229

# Frontend
VITE_API_URL=http://localhost:8000
